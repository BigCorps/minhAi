# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (será configurado na próxima etapa)
# OPENAI_API_KEY=sk-proj-...

# Porcupine (será configurado na próxima etapa)
# NEXT_PUBLIC_PORCUPINE_ACCESS_KEY=your-access-key

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI models (opcionais, somente no servidor)
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_MODEL_TOOLS=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_TRANSCRIBE=whisper-1
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_TTS=tts-1


# SDR comercial (somente servidor)
# SDR_PUBLIC_URL=https://minhai.app
# SDR_WORKER_URL=https://www.minhai.app
# SDR_WORKER_SECRET=replace-with-random-secret
# SDR_TOKEN_SECRET=replace-with-random-secret
# SDR_GOOGLE_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# SDR_LIVE_SEND=false
# SDR_EMAIL_REPLY_READ_ENABLED=false
