#!/bin/bash

# deploy-speech-stream.sh
# Script para deploy da Edge Function no Supabase

echo "🚀 Deploy: Google Speech Streaming WebSocket"
echo "============================================="
echo ""

# Verificar se Supabase CLI está instalado
if ! command -v supabase &> /dev/null; then
    echo "❌ Supabase CLI não encontrado!"
    echo ""
    echo "Instale com:"
    echo "  npm install -g supabase"
    echo ""
    exit 1
fi

echo "✅ Supabase CLI encontrado"
echo ""

# Verificar se está logado
echo "🔐 Verificando login..."
if ! supabase projects list &> /dev/null; then
    echo "❌ Não está logado no Supabase!"
    echo ""
    echo "Execute:"
    echo "  supabase login"
    echo ""
    exit 1
fi

echo "✅ Login verificado"
echo ""

# Link com projeto (se ainda não estiver linkado)
echo "🔗 Verificando link com projeto..."
if [ ! -f ".supabase/config.toml" ]; then
    echo "❌ Projeto não está linkado!"
    echo ""
    echo "Execute:"
    echo "  supabase link --project-ref SEU_PROJECT_REF"
    echo ""
    echo "Para encontrar o project-ref:"
    echo "  https://supabase.com/dashboard/project/SEU_PROJECT_REF/settings/general"
    echo ""
    exit 1
fi

echo "✅ Projeto linkado"
echo ""

# Criar estrutura de pastas se não existir
echo "📁 Criando estrutura de pastas..."
mkdir -p supabase/functions/speech-stream

# Verificar se index.ts existe
if [ ! -f "supabase/functions/speech-stream/index.ts" ]; then
    echo "❌ Arquivo index.ts não encontrado!"
    echo ""
    echo "Copie o arquivo supabase-speech-stream-index.ts para:"
    echo "  supabase/functions/speech-stream/index.ts"
    echo ""
    exit 1
fi

echo "✅ Estrutura criada"
echo ""

# Configurar secrets
echo "🔐 Configurando secrets..."
echo ""
echo "IMPORTANTE: Você precisa configurar estas variáveis:"
echo ""
echo "  GOOGLE_CLOUD_PROJECT_ID"
echo "  GOOGLE_CLOUD_CREDENTIALS"
echo ""
echo "Execute:"
echo "  supabase secrets set GOOGLE_CLOUD_PROJECT_ID=gerente-ia-483515"
echo "  supabase secrets set GOOGLE_CLOUD_CREDENTIALS='{\"type\":\"service_account\",...}'"
echo ""
read -p "Já configurou os secrets? (y/n) " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "⚠️ Configure os secrets primeiro!"
    exit 1
fi

echo "✅ Secrets configurados"
echo ""

# Deploy
echo "🚀 Fazendo deploy..."
supabase functions deploy speech-stream --no-verify-jwt

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ Deploy concluído com sucesso!"
    echo ""
    echo "🌐 URL da Edge Function:"
    echo "  https://SEU_PROJETO.supabase.co/functions/v1/speech-stream"
    echo ""
    echo "📝 Próximos passos:"
    echo "  1. Copie a URL acima"
    echo "  2. Atualize google-speech-websocket.ts com a URL"
    echo "  3. Teste no frontend!"
    echo ""
else
    echo ""
    echo "❌ Erro no deploy!"
    echo ""
    exit 1
fi