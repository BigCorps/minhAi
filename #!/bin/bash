#!/bin/bash

# Script - Limpar e Testar Login

echo "🧹 Limpando e preparando para teste de login..."
echo ""

# Cores
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# Verificar raiz
if [ ! -f "package.json" ]; then
    echo -e "${RED}❌ Execute na raiz do projeto!${NC}"
    exit 1
fi

# Limpar cache
echo -e "${BLUE}🧹 Limpando cache...${NC}"
rm -rf .next
rm -rf node_modules/.cache 2>/dev/null
echo -e "${GREEN}✓ Cache limpo${NC}"
echo ""

# Atualizar middleware (opcional)
if [ -f "middleware-final.ts" ]; then
    echo -e "${BLUE}📝 Atualizar middleware? (s/n)${NC}"
    read -p "" -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Ss]$ ]]; then
        cp middleware-final.ts middleware.ts
        echo -e "${GREEN}✓ middleware.ts atualizado${NC}"
    fi
    echo ""
fi

# Resultado
echo -e "${GREEN}================================================${NC}"
echo -e "${GREEN}✅ Preparado para testar!${NC}"
echo -e "${GREEN}================================================${NC}"
echo ""
echo -e "${YELLOW}🔴 ANTES DE TESTAR:${NC}"
echo ""
echo "1. ${BLUE}Limpar cookies do navegador:${NC}"
echo "   • Abra DevTools (F12)"
echo "   • Application → Clear site data"
echo "   • Ou use modo incógnito (Ctrl+Shift+N)"
echo ""
echo "2. ${BLUE}Iniciar servidor:${NC}"
echo "   ${BLUE}npm run dev${NC}"
echo ""
echo "3. ${BLUE}Testar login:${NC}"
echo "   • Abra http://localhost:3000/login"
echo "   • ${GREEN}Deve permanecer em /login (não redirecionar)${NC}"
echo "   • Abra Console (F12)"
echo "   • Preencha email e senha"
echo "   • Clique 'Entrar'"
echo "   • Veja logs no console:"
echo "     ${GREEN}✅ 🔑 Fazendo login...${NC}"
echo "     ${GREEN}✅ ✅ Login bem-sucedido!${NC}"
echo "     ${GREEN}✅ 🔄 Redirecionando para /...${NC}"
echo ""
echo -e "${BLUE}💡 Dica: Use modo incógnito para evitar cache!${NC}"
echo ""
echo -e "${GREEN}🚀 Pronto!${NC}"